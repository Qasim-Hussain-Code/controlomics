          "type": "array"
        },
        "data_partition": {
          "anyOf": [
            {
              "maxLength": 12000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Partition"
        },
        "independence_assumptions": {
          "default": [],
          "items": {
            "maxLength": 12000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Independence Assumptions",
          "type": "array"
        },
        "missing_information": {
          "default": [],
          "items": {
            "maxLength": 12000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Missing Information",
          "type": "array"
        },
        "sampling_unit": {
          "anyOf": [
            {
              "maxLength": 12000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sampling Unit"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "AnalyticalDesign",
      "type": "object"
    },
