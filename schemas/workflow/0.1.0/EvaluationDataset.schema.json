  "additionalProperties": false,
  "properties": {
    "annotation_origin": {
      "enum": [
        "UNASSESSED",
        "DEVELOPMENT_FIXTURE",
        "EXPERT_ATTESTATION"
      ],
      "title": "Annotation Origin",
      "type": "string"
    },
    "annotator": {
      "anyOf": [
        {
          "maxLength": 12000,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Annotator"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/EvaluationCase"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "dataset_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:]*$",
      "title": "Dataset Id",
      "type": "string"
    },
    "format": {
      "const": "controlomics.evaluation_dataset.v0.1",
      "default": "controlomics.evaluation_dataset.v0.1",
      "title": "Format",
      "type": "string"
    },
    "limitations": {
      "items": {
        "maxLength": 12000,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "annotation_origin",
    "cases",
    "limitations"
  ],
  "title": "EvaluationDataset",
  "type": "object"
}
