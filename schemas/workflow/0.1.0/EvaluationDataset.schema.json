    "EvaluationCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:]*$",
          "title": "Case Id",
          "type": "string"
        },
        "description": {
          "maxLength": 12000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "expected_findings": {
          "anyOf": [
            {
              "items": {
                "maxLength": 100,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:]*$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Findings"
        },
        "intake": {
          "anyOf": [
            {
              "$ref": "#/$defs/Intake"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "partition": {
          "enum": [
            "DEVELOPMENT",
            "VALIDATION",
            "TEST"
          ],
          "title": "Partition",
          "type": "string"
        },
        "references": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReferenceControl"
          },
          "title": "References",
          "type": "array"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_group": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:]*$",
          "title": "Source Group",
          "type": "string"
        },
        "source_identifiers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceIdentifier"
          },
          "title": "Source Identifiers",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "description",
        "partition",
        "source_group"
      ],
      "title": "EvaluationCase",
      "type": "object"
    },
    "EvidenceIdentifier": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "maxLength": 12000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Authority",
          "type": "string"
        },
        "namespace": {
          "enum": [
            "DOI",
            "PMID",
            "PMCID",
            "ACCESSION",
            "OTHER"
          ],
          "title": "Namespace",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "maxLength": 500,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "value",
        "authority"
      ],
      "title": "EvidenceIdentifier",
      "type": "object"
    },
    "Intake": {
      "additionalProperties": false,
      "properties": {
        "analysis_description": {
          "maxLength": 12000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Analysis Description",
          "type": "string"
        },
        "assumptions": {
          "default": [],
          "items": {
            "maxLength": 12000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "biological_context": {
          "$ref": "#/$defs/BiologicalContext"
        },
        "claim": {
          "maxLength": 12000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Claim",
          "type": "string"
        },
        "claim_category": {
          "enum": [
            "DESCRIPTIVE",
            "ASSOCIATIONAL",
            "COMPARATIVE",
            "PREDICTIVE",
            "STATISTICAL",
            "FUNCTIONAL",
            "MECHANISTIC",
            "CAUSAL"
          ],
          "title": "Claim Category",
          "type": "string"
        },
        "computational_support": {
          "enum": [
            "DESCRIPTIVE",
            "ASSOCIATIONAL",
            "COMPARATIVE",
            "PREDICTIVE",
            "STATISTICAL",
            "FUNCTIONAL",
            "MECHANISTIC",
            "CAUSAL"
          ],
          "title": "Computational Support",
          "type": "string"
        },
        "design": {
          "$ref": "#/$defs/AnalyticalDesign"
        },
        "methods": {
          "items": {
            "maxLength": 12000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Methods",
          "type": "array"
        },
        "observed_result": {
          "maxLength": 12000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Observed Result",
          "type": "string"
        },
        "question": {
          "maxLength": 12000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Question",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "question",
        "analysis_description",
        "methods",
        "observed_result",
        "claim",
        "claim_category",
        "computational_support"
      ],
      "title": "Intake",
      "type": "object"
    },
    "ReferenceControl": {
      "additionalProperties": false,
      "properties": {
        "control_class": {
          "enum": [
            "POSITIVE",
            "NEGATIVE",
            "NULL",
            "SPECIFICITY",
            "ROBUSTNESS",
            "CONFOUNDER",
            "FALSIFICATION"
          ],
          "title": "Control Class",
          "type": "string"
        },
        "description": {
          "maxLength": 12000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "essential": {
          "title": "Essential",
          "type": "boolean"
        },
        "reference_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:]*$",
          "title": "Reference Id",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "reference_id",
        "description",
        "control_class",
        "essential"
      ],
      "title": "ReferenceControl",
      "type": "object"
    }
