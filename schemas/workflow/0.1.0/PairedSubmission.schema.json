      "title": "Claim Id",
      "type": "string"
    },
    "rationale": {
      "maxLength": 12000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Rationale",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "claim_id",
    "rationale",
    "assumptions"
  ],
  "title": "PairedSubmission",
  "type": "object"
