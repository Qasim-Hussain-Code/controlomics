{
  "$defs": {
    "AnalyticalDesign": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sampling_unit": {
          "anyOf": [
            {
              "maxLength": 12000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sampling Unit"
        },
        "independence_assumptions": {
          "default": [],
          "items": {
            "maxLength": 12000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Independence Assumptions",
          "type": "array"
        },
        "contrasts": {
          "default": [],
          "items": {
            "maxLength": 12000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Contrasts",
          "type": "array"
        },
        "covariates": {
          "default": [],
          "items": {
            "maxLength": 12000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Covariates",
          "type": "array"
        },
        "data_partition": {
          "anyOf": [
            {
              "maxLength": 12000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Partition"
        },
        "missing_information": {
          "default": [],
          "items": {
            "maxLength": 12000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Missing Information",
          "type": "array"
        }
      },
      "title": "AnalyticalDesign",
      "type": "object"
    },
    "BiologicalContext": {
