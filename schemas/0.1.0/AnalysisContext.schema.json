  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "analysis_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:]*$",
      "title": "Analysis Id",
      "type": "string"
    },
    "scientific_question": {
      "maxLength": 12000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Scientific Question",
      "type": "string"
    },
    "analysis_description": {
      "maxLength": 12000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Analysis Description",
      "type": "string"
    },
    "methods": {
      "items": {
        "maxLength": 12000,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Methods",
      "type": "array"
    },
    "biological_context": {
      "$ref": "#/$defs/BiologicalContext"
    },
    "design": {
      "$ref": "#/$defs/AnalyticalDesign"
    },
    "observed_result": {
      "maxLength": 12000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Observed Result",
      "type": "string"
    },
    "coverage_status": {
      "default": "UNVALIDATED",
      "enum": [
        "UNVALIDATED",
        "OUTSIDE_VALIDATED_COVERAGE"
      ],
      "title": "Coverage Status",
      "type": "string"
    },
    "uncertainties": {
      "default": [],
      "items": {
        "maxLength": 12000,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Uncertainties",
      "type": "array"
    }
  },
  "required": [
    "analysis_id",
    "scientific_question",
    "analysis_description",
    "methods",
    "biological_context",
    "design",
    "observed_result"
  ],
  "title": "AnalysisContext",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:controlomics:schema:0.1.0:AnalysisContext"
}
