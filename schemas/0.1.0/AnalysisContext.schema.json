              "type": "null"
            }
          ],
          "default": null,
          "title": "Experimental Condition"
        },
        "molecular_target": {
          "anyOf": [
            {
              "maxLength": 12000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Molecular Target"
        },
        "assay_type": {
          "anyOf": [
            {
              "maxLength": 12000,
